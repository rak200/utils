# Static analysis is Layer 2: the level and the analyser's own settings live in
# vendor/rak200/coding-standard-php. What to look at, and where to cache, is ours.
includes:
    - vendor/rak200/coding-standard-php/phpstan.neon.dist

parameters:
    # canary: the standard mandates `level: max`; this restates it weaker
    level: 8
    paths:
        - src
        - tests
    tmpDir: .phpstan.cache
