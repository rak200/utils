{
    "name": "rak200/utils",
    "description": "General-purpose static utility helpers for PHP 8.4+ (Str, Arr, Iter, Num, Rand, Regex, Hash, Bit, File, Json, Base64, Hex, Dt, Url, Path, Type, Enum, Filter).",
    "version": "4.5.0",
    "type": "library",
    "license": "MIT",
    "keywords": ["utils", "helpers", "string", "array", "iterator", "lazy", "generator", "uuid", "ulid", "datetime", "sanitize", "php84"],
    "homepage": "https://github.com/rak200/utils",
    "authors": [
        {
            "name": "rak200",
            "email": "rak.ricardo@windowslive.com",
            "homepage": "https://github.com/rak200"
        }
    ],
    "support": {
        "issues": "https://github.com/rak200/utils/issues",
        "source": "https://github.com/rak200/utils"
    },
    "require": {
        "php": "^8.4",
        "ext-bcmath": "*",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "Rak200\\Utils\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.1",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.75",
        "infection/infection": "^0.34"
    },
    "autoload-dev": {
        "psr-4": {
            "Rak200\\Utils\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "infection": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv XDEBUG_MODE=coverage",
            "infection --threads=max"
        ],
        "infection-diff": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv XDEBUG_MODE=coverage",
            "infection --threads=max --git-diff-lines --git-diff-base=master"
        ]
    }
}
