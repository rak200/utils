parameters:
    level: max
    paths:
        - src
        - tests
    tmpDir: .phpstan.cache
    # Type predicates carry @phpstan-assert PHPDoc, so PHPStan can statically
    # decide guard calls made with concrete literals. The TypeTest exercises
    # exactly those concrete cases on purpose, so suppress the resulting
    # "always true / impossible type" reports for that file only.
    # NumTest documents native PHP behaviour (is_numeric of a literal) for
    # contrast, which PHPStan also constant-folds — same exemption applies.
    ignoreErrors:
        - { identifier: staticMethod.alreadyNarrowedType, path: tests/TypeTest.php }
        - { identifier: staticMethod.impossibleType,       path: tests/TypeTest.php }
        - { identifier: method.impossibleType,             path: tests/TypeTest.php }
        - { identifier: function.alreadyNarrowedType,      path: tests/NumTest.php }
        - { identifier: method.alreadyNarrowedType,        path: tests/NumTest.php }
